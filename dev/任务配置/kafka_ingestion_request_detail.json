{
  "type": "kafka",
  "spec": {
    "dataSchema": {
      "dataSource": "ds_request",
      "timestampSpec": {
        "column": "ts",
        "format": "auto"
      },
      "dimensionsSpec": {
        "dimensions": [
          "appsysid",
          "appid",
          "service_type",
          "status_code"
        ],
        "dimensionExclusions": [
          "timestamp",
          "value"
        ]
      },
      "metricsSpec": [
        {
          "type": "count",
          "name": "count"
        },
        {
          "type": "doubleSum",
          "name": "dur_sum",
          "fieldName": "dur"
        },
        {
          "type": "doubleMin",
          "name": "dur_min",
          "fieldName": "dur"
        },
        {
          "type": "doubleMax",
          "name": "dur_max",
          "fieldName": "dur"
        }
      ],
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "HOUR",
        "queryGranularity": "NONE"
      }
    },
    "ioConfig": {
      "topic": "request",
      "inputFormat": {
        "type": "json"
      },
      "consumerProperties": {
        "bootstrap.servers": "localhost:9092"
      },
      "taskCount": 1,
      "replicas": 1,
      "taskDuration": "PT1H",
      "type": "kafka"
    },
    "tuningConfig": {
      "type": "kafka",
      "maxRowsPerSegment": 100000
    }
  }
}