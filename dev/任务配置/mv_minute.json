{
  "type": "kafka",
  "spec": {
    "dataSchema": {
      "dataSource": "request-test",
      "timestampSpec": {
        "column": "ts",
        "format": "auto"
      },
      "dimensionsSpec": {
        "dimensions": ["appsysid","appid","service_type","status_code"],
        "dimensionExclusions": [
          "timestamp",
          "value"
        ]
      },
      "metricsSpec": [
        {
          "name": "count",
          "type": "count"
        },
        {
          "name": "dur_sum",
          "fieldName": "dur",
          "type": "doubleSum"
        },
        {
          "name": "dur_min",
          "fieldName": "dur",
          "type": "doubleMin"
        },
        {
          "name": "dur_max",
          "fieldName": "dur",
          "type": "doubleMax"
        }
      ],
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "HOUR",
        "queryGranularity": "MINUTE"
      }
    },
    "ioConfig": {
      "topic": "metrics",
      "inputFormat": {
        "type": "json"
      },
      "consumerProperties": {
        "bootstrap.servers": "localhost:9092"
      },
      "taskCount": 1,
      "replicas": 1,
      "taskDuration": "PT1H"
    },
    "tuningConfig": {
      "type": "kafka",
      "maxRowsPerSegment": 1000000
    }
  }
}