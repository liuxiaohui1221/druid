{
  "type": "materialized_view",
  "baseDataSource": "mv_request_minute",
  "dataSource":"mv_request_hour",
  "granularitySpec": {
    "type": "uniform",
    "segmentGranularity": "HOUR",
    "queryGranularity": "MINUTE"
  },
  "dimensionsSpec": {
    "dimensions": [
      "appsysid",
      "appid",
      "service_type",
      "status_code"
    ]
  },
  "metricsSpec": [
    {
      "name": "count",
      "type": "count"
    },
    {
      "name": "dur_sum",
      "fieldName": "dur",
      "type": "doubleSum"
    },
    {
      "name": "dur_min",
      "fieldName": "dur",
      "type": "doubleMin"
    },
    {
      "name": "dur_max",
      "fieldName": "dur",
      "type": "doubleMax"
    }
  ],
  "tuningConfig": {
    "type": "index_parallel"
  }
}